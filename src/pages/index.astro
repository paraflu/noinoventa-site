---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { articles } from '../lib/articles';
import { association } from '../data/association';
---
<BaseLayout title="Home">
  <section class="home-hero section-space">
    <div class="content-width hero-grid">
      <div><p class="eyebrow">Noventa di Piave · Comunità e partecipazione</p>
        <h1>NOI, un luogo<br />per incontrarsi.</h1>
        <p class="hero-description">{association.name}. Attività, eventi e manifestazioni per la comunità.</p>
        <div class="actions"><a class="button-primary" href="/notizie/">Esplora l’archivio</a><a class="button-secondary" href="/dove-siamo/">Il circolo e i contatti</a></div>
      </div>
      <div class="hero-emblem"><img src="/logo-noi.jpg" alt="Logo NOI" width="220" height="220" /><p>Circolo San Luigi APS<br /><span>Noventa di Piave</span></p></div>
    </div>
  </section>
  <section class="content-width section-space">
    <div class="section-heading"><div><p class="eyebrow">La memoria del circolo</p><h2>Ultimi contenuti in archivio</h2></div><a class="read-more" href="/notizie/">Vedi tutti →</a></div>
    <p class="section-intro">Articoli importati dal sito Joomla: le date sono quelle originali, non un calendario delle prossime attività.</p>
    <div class="archive-grid">{articles.slice(0, 6).map(article => <ArticleCard article={article} />)}</div>
  </section>
</BaseLayout>
