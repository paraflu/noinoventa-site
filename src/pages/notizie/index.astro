---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { articles } from '../../lib/articles';
const categories = [...new Set(articles.map(article => article.category))].sort((a, b) => a.localeCompare(b, 'it'));
---
<BaseLayout title="Archivio notizie">
  <section class="content-width section-space">
    <p class="eyebrow">Storie, iniziative e vita associativa</p><h1>Archivio notizie</h1>
    <p class="section-intro">{articles.length} articoli pubblici dal prefisso jos25_. Un archivio storico, non un programma aggiornato.</p>
    <div class="notice">POC editoriale: testi semplificati, senza media e allegati. Alcuni recapiti sono omessi. I contenuti richiedono revisione prima di una futura pubblicazione.</div>
    <form class="archive-filters" role="search" onsubmit="return false">
      <label>Cerca nell’archivio<input id="article-search" type="search" placeholder="Titolo o testo" /></label>
      <label>Categoria<select id="article-category"><option value="">Tutte le categorie</option>{categories.map(category => <option value={category}>{category}</option>)}</select></label>
    </form>
    <p id="results-count" role="status" aria-live="polite">{articles.length} articoli</p>
    <div class="archive-grid" id="archive-grid">{articles.map(article => <div data-category={article.category} data-search={`${article.title} ${article.paragraphs.join(' ')}`.toLocaleLowerCase('it')}><ArticleCard article={article} /></div>)}</div>
    <p id="no-results" hidden>Nessun articolo corrisponde alla ricerca.</p>
  </section>
  <script>
    const search = document.querySelector<HTMLInputElement>('#article-search');
    const category = document.querySelector<HTMLSelectElement>('#article-category');
    const cards = [...document.querySelectorAll<HTMLElement>('#archive-grid > div')];
    function filter() {
      let visible = 0;
      const query = search?.value.trim().toLocaleLowerCase('it') || '';
      for (const card of cards) {
        card.hidden = !((!category?.value || card.dataset.category === category.value) && (card.dataset.search || '').includes(query));
        if (!card.hidden) visible++;
      }
      document.querySelector('#results-count')!.textContent = `${visible} articoli`;
      document.querySelector<HTMLElement>('#no-results')!.hidden = visible > 0;
    }
    search?.addEventListener('input', filter);
    category?.addEventListener('change', filter);
  </script>
</BaseLayout>
