---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleBody from '../components/ArticleBody.astro';
import { association } from '../data/association';
import { articles, articleMenus } from '../lib/articles';
const menu = articleMenus.find(menu => menu.path === '/dove-siamo/');
const legacy = articles.find(article => article.id === menu?.articleId);
---
<BaseLayout title="Il circolo e i contatti">
  <section class="content-width section-space">
    <p class="eyebrow">Noventa di Piave</p><h1>Il circolo e i contatti</h1>
    <p class="section-intro">{association.name}</p>
    <aside class="notice">{association.verification} Orari e cellulari presenti nella vecchia demo non vengono proposti come attuali: occorre conferma.</aside>
    <div class="archive-grid section-space">
      <section class="archive-card"><h2>Dove siamo</h2><p>{association.address}<br />{association.locality}</p><a class="read-more" href={association.map} target="_blank" rel="noopener noreferrer">Apri la mappa ↗</a><p>Coordinate del POC, da verificare. La mappa si apre solo su richiesta.</p></section>
      <section class="archive-card"><h2>Contatti del POC</h2><p><a href={`mailto:${association.email}`}>{association.email}</a></p><p><a href={`tel:${association.phone.replaceAll(' ', '')}`}>{association.phone}</a></p><a class="read-more" href={association.facebook} target="_blank" rel="noopener noreferrer">Pagina Facebook ↗</a></section>
    </div>
  </section>
  {legacy && <section aria-label="Contenuto storico del menu Joomla"><ArticleBody article={legacy} embedded /></section>}
</BaseLayout>
