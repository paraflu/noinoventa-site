---
import { association } from '../data/association';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="content-width footer-grid">
    <div><h2>{association.name}</h2><p>Attività, eventi e manifestazioni per la comunità di Noventa di Piave.</p><p class="eyebrow">Prototipo statico · Non sito istituzionale</p></div>
    <div><h2>Riferimenti del POC</h2><p>{association.address}<br />{association.locality}</p><p><a href={`mailto:${association.email}`}>{association.email}</a> · {association.phone}</p><small>{association.verification}</small></div>
    <nav aria-label="Collegamenti nel piè di pagina"><a href="/notizie/">Archivio notizie</a><a href="/dove-siamo/">Il circolo e i contatti</a><a href={association.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a></nav>
  </div>
  <p class="content-width copyright">© {year} {association.name} · POC in revisione, nessuna pubblicazione della migrazione.</p>
</footer>
